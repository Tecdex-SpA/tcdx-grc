{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tcdx:applicability-context-audit:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "requirement_applicability_id",
    "applicability_version",
    "row_version",
    "tenant_id",
    "scope_subject_id",
    "context"
  ],
  "properties": {
    "profile": {
      "const": "APPLICABILITY_CONTEXT_V1"
    },
    "requirement_applicability_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "applicability_version": {
      "type": "integer",
      "minimum": 1
    },
    "row_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scope_subject_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "knowledge_version_id",
            "knowledge_item_id",
            "version_number",
            "content_hash",
            "subject_id",
            "ownership_class"
          ],
          "properties": {
            "knowledge_version_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "knowledge_item_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "version_number": {
              "type": "integer",
              "minimum": 1
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "subject_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "ownership_class": {
              "const": "TENANT_OWNED"
            }
          }
        }
      ]
    }
  }
}
