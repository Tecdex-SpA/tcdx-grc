import {test} from 'node:test';import assert from 'node:assert/strict';
import {databaseConfig} from '../../../../scripts/foundations/db.ts';
const saved={...process.env};const cert=import.meta.dirname+'/QA_ADMINISTRATIVE_PUBLIC_CERT.pem';
function setup(values:Record<string,string>){for(const k of Object.keys(process.env))if(k.startsWith('DATABASE_'))delete process.env[k];Object.assign(process.env,{DATABASE_USER:'unit_user',...values});}
function reset(){for(const k of Object.keys(process.env))if(k.startsWith('DATABASE_'))delete process.env[k];for(const [k,v] of Object.entries(saved))if(k.startsWith('DATABASE_'))process.env[k]=v;}
test('verify-full separates logical hostname, numeric address and explicit trust',()=>{try{setup({DATABASE_HOST:'db-tecdex',DATABASE_HOSTADDR:'192.168.2.40',DATABASE_SSL_MODE:'verify-full',DATABASE_SSL_ROOT_CERT:cert});const c=databaseConfig();assert.equal(c.host,'192.168.2.40');assert.ok(c.ssl);assert.equal(c.ssl.servername,'db-tecdex');assert.equal(c.ssl.rejectUnauthorized,true);assert.ok(c.ssl.ca?.includes('BEGIN CERTIFICATE'));}finally{reset();}});
test('address override cannot silently use weaker SSL mode or DNS address',()=>{try{setup({DATABASE_HOST:'db-tecdex',DATABASE_HOSTADDR:'192.168.2.40',DATABASE_SSL_MODE:'no-verify'});assert.throws(databaseConfig,/verify-full/);process.env.DATABASE_SSL_MODE='verify-full';process.env.DATABASE_HOSTADDR='alias.invalid';assert.throws(databaseConfig,/literal IP/);}finally{reset();}});
test('verify-full fails closed without approved trust material',()=>{try{setup({DATABASE_HOST:'db-tecdex',DATABASE_HOSTADDR:'192.168.2.40',DATABASE_SSL_MODE:'verify-full'});assert.throws(databaseConfig,/explicit approved/);}finally{reset();}});
test('existing isolated socket configuration remains unchanged',()=>{try{setup({DATABASE_HOST:'/var/run/postgresql',DATABASE_SSL_MODE:'disable'});const c=databaseConfig();assert.equal(c.host,'/var/run/postgresql');assert.equal(c.ssl,false);}finally{reset();}});
