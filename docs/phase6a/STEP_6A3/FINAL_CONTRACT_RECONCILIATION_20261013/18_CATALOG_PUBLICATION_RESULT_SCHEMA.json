{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "manifest_sha256",
    "published_aggregates"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "const": "COMMERCIAL_CATALOG_PUBLICATION_RESULT_V1"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "published_aggregates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregate_type",
          "aggregate_id"
        ],
        "properties": {
          "aggregate_type": {
            "type": "string",
            "enum": [
              "CommercialFamily",
              "PlanVersion"
            ]
          },
          "aggregate_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
