NODE_ENV=qa
PORT=4000

DATABASE_HOST=192.168.2.40
DATABASE_PORT=5432
DATABASE_NAME=tcdx-grc
DATABASE_USER=<secret>
DATABASE_PASSWORD=<secret>
DATABASE_SSL_MODE=disable

OIDC_ISSUER=<runtime-configuration>
OIDC_CLIENT_ID=<runtime-configuration>
OIDC_CLIENT_SECRET=<secret-reference>
OIDC_REDIRECT_URI=<runtime-configuration>
# Derived safe Zoho/runtime defaults: openid profile email; RS256; client_secret_post.
# Override only when provider discovery requires another already-allowed value.
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_TOKEN_ENDPOINT_AUTH_METHOD="client_secret_post"

APP_JWT_PRIVATE_KEY_FILE="/home/tecdex/.secrets/tcdx-grc-qa/application-private.pem"
APP_JWT_PUBLIC_KEY_FILE=/home/tecdex/.secrets/tcdx-grc-qa/application-public.pem
# Remaining application-token values are canonically derived by the runtime:
# issuer=https://grc-bk.tcdx.int; audience=tcdx-grc-api; kid=public-key fingerprint;
# algorithm=RS256; maximum lifetime=300s; clock tolerance=5s.
FRONTEND_ORIGIN=https://grc.tecdex.net

OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=tcdx-grc-evidence
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_HOST_FILE=/home/tecdex/.secrets/tcdx-grc-qa/object-storage-access-key
OBJECT_STORAGE_SECRET_KEY_HOST_FILE=/home/tecdex/.secrets/tcdx-grc-qa/object-storage-secret-key
OBJECT_STORAGE_KMS_KEY_HOST_FILE=/home/tecdex/.secrets/tcdx-grc-qa/object-storage-kms-key
OBJECT_STORAGE_ACCESS_KEY_FILE=/run/secrets/object_storage_access_key
OBJECT_STORAGE_SECRET_KEY_FILE=/run/secrets/object_storage_secret_key
OBJECT_STORAGE_ENCRYPTION_KEY_REF=minio-sse-s3:tcdx-grc-qa
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
OBJECT_STORAGE_MAX_UPLOAD_BYTES=26214400
OBJECT_STORAGE_ALLOW_INSECURE_HTTP=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
