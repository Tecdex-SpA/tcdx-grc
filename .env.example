# Runtime identity. Values are placeholders; no secret is stored here.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL 16 authority. Supply credentials through the deployment secret mechanism.
DATABASE_HOST=192.168.2.40
DATABASE_PORT=5432
DATABASE_NAME=tcdx-grc
DATABASE_USER=<secret-reference>
DATABASE_PASSWORD=<secret-reference>
DATABASE_SSL_MODE=require
DATABASE_BACKUP_REFERENCE=<approved-backup-or-pitr-reference>

# External OIDC proves identity only. Provider tokens are never API bearers.
OIDC_ISSUER=<approved-runtime-value>
OIDC_CLIENT_ID=<approved-runtime-value>
OIDC_CLIENT_SECRET=<secret-reference>
OIDC_REDIRECT_URI=<approved-runtime-value>
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_TOKEN_ENDPOINT_AUTH_METHOD="client_secret_post"

# TCDX Managed Identity is a separate confidential OIDC client on the same auth boundary.
# Provision the client secret as a protected file at deployment; never place its value here.
# MANAGED_IDENTITY_OIDC_ISSUER=https://iam.grc.tecdex.net/realms/tcdx-managed-identity
# MANAGED_IDENTITY_OIDC_CLIENT_ID=tcdx-grc
# MANAGED_IDENTITY_OIDC_CLIENT_SECRET_FILE=<protected-secret-file-reference>
# MANAGED_IDENTITY_OIDC_REDIRECT_URI=https://grc.tecdex.net/auth/callback

# Dedicated internal Keycloak Admin API client under MI6-SEC-001. The secret must be a mode-0600 host file.
# MANAGED_IDENTITY_ADMIN_BASE_URL=http://192.168.2.46:8180
# MANAGED_IDENTITY_ADMIN_CLIENT_ID=tcdx-grc-managed-identity-provisioner
# MANAGED_IDENTITY_ADMIN_CLIENT_SECRET_FILE=<protected-host-secret-file-reference>

# TCDX application JWT. Key material is supplied by the deployment secret mechanism.
APP_JWT_PRIVATE_KEY_FILE=<secret-file-reference>
APP_JWT_PUBLIC_KEY_FILE=<public-key-file-reference>
# Defaults: canonical backend issuer, tcdx-grc-api audience, fingerprint-derived kid,
# RS256, 300-second maximum lifetime and 5-second clock tolerance.
FRONTEND_ORIGIN=https://grc.tecdex.net

# S3-compatible object storage. Credentials come from runtime secret files.
OBJECT_STORAGE_ENDPOINT=<approved-runtime-value>
OBJECT_STORAGE_BUCKET=<approved-runtime-value>
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_FILE=<secret-file-reference>
OBJECT_STORAGE_SECRET_KEY_FILE=<secret-file-reference>
OBJECT_STORAGE_ENCRYPTION_KEY_REF=<non-secret-kms-key-reference>
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
OBJECT_STORAGE_MAX_UPLOAD_BYTES=26214400
# Only for isolated development/QA networks; production always requires HTTPS.
OBJECT_STORAGE_ALLOW_INSECURE_HTTP=false
CLAMAV_HOST=<approved-runtime-value>
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000

# Approved infrastructure identity; not a credential.
BACKEND_PUBLIC_ORIGIN=https://grc-bk.tcdx.int
FRONTEND_API_ORIGIN=https://grc-bk.tcdx.int
AI_SERVICE_ORIGIN=https://ia2.tcdx.int
