# Runtime identity. Values are placeholders; no secret is stored here.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL 16 authority. Supply credentials through the deployment secret mechanism.
DATABASE_HOST=192.168.2.40
DATABASE_PORT=5432
DATABASE_NAME=tcdx-grc
DATABASE_USER=<secret-reference>
DATABASE_PASSWORD=<secret-reference>
DATABASE_SSL_MODE=require
DATABASE_BACKUP_REFERENCE=<approved-backup-or-pitr-reference>

# Authentication stays fail-closed until the exact approved JWT/JWKS adapter exists.
OIDC_ISSUER=<approved-runtime-value>
OIDC_AUDIENCE=<approved-runtime-value>
OIDC_JWKS_URI=<approved-runtime-value>
OIDC_ALLOWED_ALGORITHMS=<approved-runtime-value>

# S3-compatible object storage adapter remains dependency-gated.
OBJECT_STORAGE_ENDPOINT=<approved-runtime-value>
OBJECT_STORAGE_BUCKET=<approved-runtime-value>
OBJECT_STORAGE_CREDENTIAL_REFERENCE=<secret-reference>

# Approved infrastructure identity; not a credential.
BACKEND_PUBLIC_ORIGIN=https://grc-bk.tcdx.int
FRONTEND_API_ORIGIN=https://grc-bk.tcdx.int
AI_SERVICE_ORIGIN=https://ia2.tcdx.int
